{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "bugs-and-cells.vercel.app" }],
      "destination": "https://bugs-and-cells.quentin.software/$1",
      "permanent": true
    }
  ]
}
